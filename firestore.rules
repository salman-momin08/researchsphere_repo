rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users Collection
    match /users/{userId} {
      // CREATE:
      // - User must be authenticated.
      // - User can only create their own user document (userId in path must match auth.uid).
      // - The 'userId' field in the document must also match their auth.uid.
      // - 'isAdmin' must be false unless explicitly set by trusted logic (e.g., for admin-creator email via AuthContext).
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.userId == request.auth.uid &&
                       // Let AuthContext determine isAdmin for creator email, otherwise it must be false
                       ( (request.resource.data.isAdmin == true && request.auth.token.email == "admin-creator@researchsphere.com") || 
                         (request.resource.data.isAdmin == false) ||
                         !('isAdmin' in request.resource.data) // if isAdmin is not provided, it's fine, AuthContext defaults to false
                       );

      // READ (GET):
      // - User can read their own profile.
      // - An admin can read any user's profile.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // UPDATE:
      // - User can update their own profile.
      // - They cannot change 'isAdmin', 'userId', or 'email' fields.
      // - An admin can update any field of *another* user's profile, including 'isAdmin' and 'role'.
      // - An admin cannot use this rule to change their *own* 'isAdmin' status via client (must be done via console or dedicated backend function).
      allow update: if request.auth != null &&
                       (
                         // Case 1: User updating their own profile
                         (request.auth.uid == userId &&
                           (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
                           (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
                           (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
                         ) ||
                         // Case 2: Admin updating *another* user's profile
                         (isAdmin() && request.auth.uid != userId)
                       );

      // LIST:
      // - Any authenticated user can list/query users.
      // - This is primarily for client-side uniqueness checks during profile updates and for admin panel lists.
      allow list: if request.auth != null;

      // DELETE:
      // - Only admins can delete user accounts (if this functionality is built).
      allow delete: if isAdmin();
    }

    // Papers Collection
    match /papers/{paperId} {
      // Helper function to check if the requester is the owner of the specific paper document
      function isPaperOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }

      // READ (GET):
      // - Paper owner can read their paper.
      // - Admin can read any paper.
      // - Any user (authenticated or not) can read a 'Published' paper.
      allow get: if isPaperOwner() || isAdmin() || resource.data.status == 'Published';

      // LIST:
      // - Admins can list all papers.
      // - Authenticated users can list papers if the query filters by their 'userId' (for their dashboard).
      // - Any user (authenticated or not) can list papers if the query filters by 'status' == 'Published'.
      allow list: if isAdmin() ||
                     (request.auth != null && request.query.filters.find(f => f[0] == 'userId' && f[2] == request.auth.uid) != null) ||
                     (request.query.filters.find(f => f[0] == 'status' && f[2] == 'Published') != null);


      // CREATE:
      // - Authenticated user can create a paper.
      // - The 'userId' in the new paper document must match the creator's auth.uid.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // UPDATE / DELETE:
      // - Paper owner can update/delete their paper.
      // - Admin can update/delete any paper.
      allow update, delete: if isPaperOwner() || isAdmin();

      // REVIEW SUBMISSION:
      // - An assigned reviewer can add a review.
      // - They must be authenticated.
      // - Their UID must be in the paper's 'assignedReviewerIds' array.
      // - They can only add to the 'reviews' array, not modify existing ones by others.
      // - The review they add must have their 'reviewerId' matching their auth.uid.
      match /reviews/{reviewId} { // This path is conceptual for arrayUnion
        allow write: if request.auth != null &&
                        request.auth.uid in get(/databases/$(database)/documents/papers/$(paperId)).data.assignedReviewerIds &&
                        request.resource.data.reviewerId == request.auth.uid;
      }
      // Rule for arrayUnion on 'reviews' field directly
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.assignedReviewerIds &&
                       request.resource.data.reviews.size() == resource.data.reviews.size() + 1 && // only adding one
                       request.resource.data.reviews[request.resource.data.reviews.size() - 1].reviewerId == request.auth.uid; // new review is theirs
    }
  }
}

    