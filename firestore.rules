
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an admin
    // This relies on the user being able to read their own document.
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the requester is the owner of a user document
    function isUserDocumentOwner(userIdInPath) {
      return request.auth != null && request.auth.uid == userIdInPath;
    }

    // Users Collection
    match /users/{userId} {
      // READ (GET):
      // 1. An authenticated user can read their own profile.
      // 2. An admin can read any user's profile.
      allow get: if request.auth != null &&
                    (isUserDocumentOwner(userId) || isAdmin());

      // LIST (Query):
      // - To enable LOGIN BY USERNAME: Unauthenticated clients need to query for username.
      //   Setting 'allow list: if true;' allows anyone to query the users collection.
      //   Individual user documents are still protected by the 'get' rule above.
      //   Client query for username: where("username", "==", enteredUsername)
      // - For OTHER AUTHENTICATED PURPOSES (e.g., client-side uniqueness checks by an admin):
      //   Authenticated users can also list/query.
      allow list: if true; // MODIFIED: Allows username lookup before login

      // CREATE:
      // - User must be authenticated.
      // - User can only create their own user document.
      // - The 'userId' field in the document must also match their auth.uid.
      // - 'isAdmin' can only be true if set by predefined admin creator emails (handled by AuthContext logic before write).
      //   The rule here ensures a regular user cannot set isAdmin to true during self-creation.
      allow create: if request.auth != null &&
                       isUserDocumentOwner(userId) &&
                       request.resource.data.userId == request.auth.uid &&
                       (
                         // Regular user creating profile, isAdmin must be false or not present (will default to false)
                         (request.resource.data.isAdmin == false || !('isAdmin' in request.resource.data)) ||
                         // Or, if isAdmin is true, it must be for specific admin creator emails (AuthContext handles this logic,
                         // this rule is a safeguard if client code was compromised).
                         (request.resource.data.isAdmin == true &&
                           (request.auth.token.email == "admin-creator@researchsphere.com" || request.auth.token.email == "admin@example.com")
                         )
                       );

      // UPDATE:
      // - User can update their own profile, but cannot change 'isAdmin', 'userId', or 'email'.
      // - An admin can update any field of *another* user's profile (including 'isAdmin').
      //   (Note: Admin updating their own profile is subject to user-owner rules if they don't use admin specific path)
      allow update: if request.auth != null &&
                       (
                         // Case 1: User updating their own profile
                         (isUserDocumentOwner(userId) &&
                           (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) && // Cannot make self admin
                           (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) && // Cannot change userId
                           (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) // Cannot change email
                         ) ||
                         // Case 2: Admin updating *another* user's profile
                         (isAdmin() && !isUserDocumentOwner(userId))
                       );

      // DELETE:
      // - Only admins can delete user accounts.
      allow delete: if isAdmin();
    }

    // Papers Collection
    match /papers/{paperId} {
      // Helper function to check if the requester is the owner of the specific paper document
      function isPaperOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }
      function isAssignedReviewer() {
        // Ensure assignedReviewerIds exists and is an array before checking
        return request.auth != null && 
               resource.data.assignedReviewerIds != null && 
               (request.auth.uid in resource.data.assignedReviewerIds);
      }

      // READ (GET):
      // - Paper owner can read their paper.
      // - Admin can read any paper.
      // - Any authenticated user can read a 'Published' paper (for search results).
      // - An assigned reviewer can read the paper they are assigned to.
      allow get: if (request.auth != null && (isPaperOwner() || isAdmin() || isAssignedReviewer())) ||
                    (resource.data.status == 'Published'); // Published papers are publicly gettable

      // LIST:
      // Allows broader querying. Security for individual document reads is handled by the 'get' rule above
      // and client-side query construction (e.g., where("assignedReviewerIds", "array-contains", request.auth.uid)).
      allow list: if true;


      // CREATE:
      // - Authenticated user can create a paper.
      // - The 'userId' in the new paper document must match the creator's auth.uid.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // UPDATE:
      // - Paper owner or Admin can update most fields.
      // - Assigned reviewers can only add to the 'reviews' array.
      allow update: if (isPaperOwner() || isAdmin()) ||
                     ( // Reviewer adding a review
                       request.auth != null &&
                       isAssignedReviewer() && // Use the helper function
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'lastUpdatedAt']) && // Only reviews and lastUpdatedAt can change
                       request.resource.data.reviews.size() == resource.data.reviews.size() + 1 && // Only adding one review
                       request.resource.data.reviews[request.resource.data.reviews.size() - 1].reviewerId == request.auth.uid
                     );

      // DELETE:
      // - Paper owner or Admin can delete.
      allow delete: if isPaperOwner() || isAdmin();
    }

    // Contact Submissions Collection
    match /contactSubmissions/{submissionId} {
      allow create: if true; // Anyone can submit
      allow read, list, update, delete: if isAdmin(); // Only admins manage submissions
    }
  }
}
