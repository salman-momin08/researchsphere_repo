rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      // Check if the user document exists and if isAdmin is true
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isPaperOwner() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read their own profile. Admins can read any.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Authenticated users can list user data (e.g., for username/phone uniqueness checks during profile update).
      allow list: if request.auth != null;

      // Authenticated users can create their own profile document.
      // The userId in the document must match their auth uid.
      // They cannot make themselves an admin during creation unless explicitly handled by backend/trusted client logic.
      allow create: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.userId == request.auth.uid &&
                       // Ensure isAdmin is false if present, or not present (AuthContext will set for creator)
                       (request.resource.data.isAdmin == false || !('isAdmin' in request.resource.data));


      // Authenticated users can update their own profile.
      // They cannot change their isAdmin status via a direct update.
      allow update: if request.auth != null && request.auth.uid == userId &&
                       (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin);
                       // The above line means: if isAdmin is NOT part of the incoming update, allow.
                       // OR if isAdmin IS part of the incoming update, its value must match the existing value.
    }

    // Papers Collection
    match /papers/{paperId} {
      // Read operations (get, list)
      allow get: if (isPaperOwner() || isAdmin() || (request.auth != null && resource.data.status == 'Published'));

      // Consolidated list rule for papers
      allow list: if request.auth != null &&
                     (
                       isAdmin() || // Admins can list all based on their queries
                       (request.query.filters.size() > 0 && request.query.filters[0][0] == 'userId' && request.query.filters[0][2] == request.auth.uid) || // User listing their own papers
                       (request.query.filters.size() > 0 && request.query.filters[0][0] == 'status' && request.query.filters[0][2] == 'Published') // Authenticated users listing published papers
                     );

      // Create operations
      // Authenticated users can create papers for themselves.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Update and Delete operations
      // Only paper owner or an admin can update/delete.
      allow update, delete: if isPaperOwner() || isAdmin();
    }
  }
}
