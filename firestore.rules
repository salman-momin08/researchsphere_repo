
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users Collection
    match /users/{userId} {
      // CREATE:
      // - User must be authenticated.
      // - User can only create their own user document.
      // - 'isAdmin' must be false or not present during self-creation.
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.userId == request.auth.uid &&
                       (request.resource.data.isAdmin == false || !('isAdmin' in request.resource.data));

      // READ (GET):
      // - User can read their own profile.
      // - An admin can read any user's profile.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // UPDATE:
      // - User can update their own profile, but cannot change 'isAdmin', 'userId', or 'email'.
      // - An admin can update most fields of *another* user's profile, including 'isSuspended' and 'isAdmin'.
      // - An admin cannot use this rule to change their *own* 'isAdmin' or 'isSuspended' status.
      allow update: if request.auth != null &&
                       (
                         // Case 1: User updating their own profile
                         (request.auth.uid == userId &&
                           (!('isAdmin'in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
                           (!('isSuspended'in request.resource.data) || request.resource.data.isSuspended == resource.data.isSuspended) && // User cannot change their own suspension
                           (!('userId'in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
                           (!('email'in request.resource.data) || request.resource.data.email == resource.data.email)
                         ) ||
                         // Case 2: Admin updating *another* user's profile
                         (isAdmin() && request.auth.uid != userId)
                       );

      // LIST:
      // - Any authenticated user can list/query users (for client-side uniqueness checks, reviewer selection).
      allow list: if request.auth != null;

      // DELETE:
      // - Only admins can delete user accounts.
      allow delete: if isAdmin();
    }

    // Papers Collection
    match /papers/{paperId} {
      // Helper function to check if the requester is the owner of the specific paper document
      function isPaperOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }

      // Helper function to check if the requester is an assigned reviewer for this paper
      function isAssignedReviewer() {
        return request.auth != null && resource.data.assignedReviewerIds.hasAny([request.auth.uid]);
      }

      // READ (GET):
      // - Paper owner can read their paper.
      // - Admin can read any paper.
      // - Any user (even unauthenticated) can read a 'Published' paper.
      allow get: if isPaperOwner() || isAdmin() || resource.data.status == 'Published';

      // LIST:
      // - Admins can list all papers.
      // - Authenticated users can list papers if the query filters by their 'userId'.
      // - Anyone (even unauthenticated) can list papers if the query filters by 'status' == 'Published'.
      allow list: if isAdmin() ||
                     (request.auth != null && request.query.filters.find(f => f[0] == 'userId' && f[2] == request.auth.uid) != null) ||
                     (request.query.filters.find(f => f[0] == 'status' && f[2] == 'Published') != null);


      // CREATE:
      // - Authenticated user can create a paper.
      // - The 'userId' in the new paper document must match the creator's auth.uid.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // UPDATE:
      // - Paper owner can update their paper.
      // - Admin can update any paper (includes assigning reviewers, changing status).
      // - An assigned reviewer can update the 'reviews' array (to add their review).
      allow update: if isPaperOwner() || isAdmin() ||
                       (isAssignedReviewer() && request.resource.data.reviews.size() == resource.data.reviews.size() + 1 &&
                        request.resource.data.reviews[-1].reviewerId == request.auth.uid && // Ensure they are adding their own review
                        !request.resource.data.reviews[-1].keys().hasAny(['reviewerId', 'submittedAt'])); // Cannot modify reviewerId or submittedAt of their new review via this update path

      // DELETE:
      // - Paper owner can delete their paper.
      // - Admin can delete any paper.
      allow delete: if isPaperOwner() || isAdmin();
    }
  }
}
