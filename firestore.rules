
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the requester is the owner of a user document
    function isUserDocumentOwner(userIdInPath) {
      return request.auth != null && request.auth.uid == userIdInPath;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if request.auth != null &&
                    (isUserDocumentOwner(userId) || isAdmin());

      allow list: if true; // Allows username lookup before login and admin queries

      allow create: if request.auth != null &&
                       isUserDocumentOwner(userId) &&
                       request.resource.data.userId == request.auth.uid &&
                       (
                         (request.resource.data.isAdmin == false || !('isAdmin' in request.resource.data)) ||
                         (request.resource.data.isAdmin == true &&
                           (request.auth.token.email == "admin-creator@researchsphere.com" || request.auth.token.email == "admin@example.com")
                         )
                       );

      allow update: if request.auth != null &&
                       (
                         (isUserDocumentOwner(userId) &&
                           (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
                           (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
                           (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
                         ) ||
                         (isAdmin() && !isUserDocumentOwner(userId))
                       );

      allow delete: if isAdmin();
    }

    // Papers Collection
    match /papers/{paperId} {
      function isPaperOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }
      function isAssignedReviewer() {
        return request.auth != null &&
               resource.data.assignedReviewerIds != null &&
               (request.auth.uid in resource.data.assignedReviewerIds); // 'in' works for array membership check
      }

      allow get: if (request.auth != null && (isPaperOwner() || isAdmin() || isAssignedReviewer())) ||
                    (resource.data.status == 'Published');

      // MODIFIED: Allow list: if true; relies on strong 'get' rules and client-side query filtering.
      // This allows authenticated users to query for their papers (authors/reviewers)
      // and unauthenticated users to query for published papers (client sends status=='Published').
      allow list: if true;

      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      allow update: if
                     (isPaperOwner() || isAdmin()) || // Paper owner or Admin can update
                     ( // Reviewer adding a review
                       request.auth != null &&
                       isAssignedReviewer() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'lastUpdatedAt']) &&
                       request.resource.data.reviews != null && // Ensure reviews array exists in the incoming data
                       ( // Check for adding exactly one review
                         (resource.data.reviews == null && request.resource.data.reviews.size() == 1) || // Adding the first review
                         (resource.data.reviews != null && request.resource.data.reviews.size() == resource.data.reviews.size() + 1) // Adding a subsequent review
                       ) &&
                       request.resource.data.reviews[request.resource.data.reviews.size() - 1].reviewerId == request.auth.uid // The newly added review must be by the current user
                     );

      allow delete: if isPaperOwner() || isAdmin();
    }

    // Contact Submissions Collection
    match /contactSubmissions/{submissionId} {
      allow create: if true; // Anyone can submit
      allow read, list, update, delete: if isAdmin(); // Only admins manage submissions
    }
  }
}

    