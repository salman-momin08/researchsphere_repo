rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the requester is the owner of the resource
    function isOwner(userIdFromResource) {
      return request.auth != null && request.auth.uid == userIdFromResource;
    }

    // Users Collection
    match /users/{userId} {
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.userId == request.auth.uid &&
                       (
                         (request.resource.data.isAdmin == false || !('isAdmin' in request.resource.data)) ||
                         (request.resource.data.isAdmin == true && request.auth.token.email_verified && (request.auth.token.email == "admin-creator@researchsphere.com" || request.auth.token.email == "admin@example.com"))
                       );

      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow update: if request.auth != null &&
                       (
                         // Case 1: User updating their own profile (cannot change critical fields by themselves)
                         (request.auth.uid == userId &&
                           (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
                           (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&
                           (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)
                         ) ||
                         // Case 2: Admin updating *another* user's profile (can change any field, including isAdmin and isSuspended)
                         (isAdmin() && request.auth.uid != userId)
                       );

      allow list: if request.auth != null; // For username/phone uniqueness checks by authenticated users, and admin listings

      allow delete: if isAdmin();
    }

    // Papers Collection
    match /papers/{paperId} {
      function isPaperOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }
      function isAssignedReviewer() {
        return request.auth != null && resource.data.assignedReviewerIds != null && request.auth.uid in resource.data.assignedReviewerIds;
      }

      allow get: if isPaperOwner() || isAdmin() || (request.auth != null && resource.data.status == 'Published') || isAssignedReviewer();

      allow list: if request.auth != null &&
                     (
                       isAdmin() ||
                       (resource.data.userId == request.auth.uid) || // User listing their own papers
                       (resource.data.status == 'Published') ||      // Public listing published papers
                       (resource.data.assignedReviewerIds != null && request.auth.uid in resource.data.assignedReviewerIds) // Reviewer listing their assigned papers
                     );

      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // For reviewers adding their review
      allow update: if (isPaperOwner() || isAdmin()) ||
                     (isAssignedReviewer() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'lastUpdatedAt']) &&
                       request.resource.data.reviews.size() == resource.data.reviews.size() + 1 &&
                       request.resource.data.reviews[request.resource.data.reviews.size() - 1].reviewerId == request.auth.uid
                     );
      
      allow delete: if isPaperOwner() || isAdmin();
    }
  }
}
