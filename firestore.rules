rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is an admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users Collection
    match /users/{userId} {
      // CREATE:
      // - User must be authenticated.
      // - User can only create their own user document (userId in path must match auth.uid).
      // - The 'userId' field in the document must also match their auth.uid.
      // - During self-creation, 'isAdmin' must be false or not present (AuthContext handles true for admin-creator email).
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.userId == request.auth.uid &&
                       (
                         // Allow if isAdmin is explicitly false
                         (request.resource.data.isAdmin == false) ||
                         // Allow if isAdmin is not present in the request (AuthContext defaults it to false)
                         (!('isAdmin' in request.resource.data)) ||
                         // Allow if requester is an admin creator and is setting isAdmin to true
                         (request.auth.token.email == "admin-creator@researchsphere.com" && request.resource.data.isAdmin == true)
                       );

      // READ (GET):
      // - User can read their own profile.
      // - An admin can read any user's profile.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // UPDATE:
      // - User can update their own profile, but cannot change 'isAdmin', 'userId', or 'email'.
      // - An admin can update any field of *another* user (including 'isAdmin').
      // - An admin cannot use this rule to change their *own* 'isAdmin' status if this rule were to be used by an admin for self-update (it would be caught by the first part of OR).
      allow update: if request.auth != null &&
                       (
                         // Case 1: User updating their own profile (cannot change critical fields)
                         (request.auth.uid == userId &&
                           (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) && // Cannot change isAdmin unless it's the same
                           (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId) &&     // Cannot change userId
                           (!('email' in request.resource.data) || request.resource.data.email == resource.data.email)           // Cannot change email
                         ) ||
                         // Case 2: Admin updating *another* user's profile (can change any field, including isAdmin)
                         (isAdmin() && request.auth.uid != userId)
                       );

      // LIST:
      // - Any authenticated user can list/query users.
      // - This is primarily for client-side uniqueness checks (username, phone number) during profile updates.
      allow list: if request.auth != null;

      // DELETE:
      // - Only admins can delete user accounts (if this functionality is built and needed).
      allow delete: if isAdmin();
    }

    // Papers Collection
    match /papers/{paperId} {
      // Helper function to check if the requester is the owner of the specific paper document
      function isPaperOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }
       function isAssignedReviewer() {
        return request.auth != null && request.auth.uid in resource.data.assignedReviewerIds;
      }

      // READ (GET):
      // - Paper owner can read their paper.
      // - Admin can read any paper.
      // - An assigned reviewer can read a paper they are assigned to.
      // - Any user (authenticated or not) can read a 'Published' paper (for search results).
      allow get: if isPaperOwner() || isAdmin() || isAssignedReviewer() || resource.data.status == 'Published';

      // LIST:
      // - Admins can list all papers.
      // - Authenticated users can list papers if the query filters by their 'userId' (for their dashboard).
      // - Authenticated users can list papers if the query filters for papers assigned to them.
      // - Anyone (authenticated or not) can list papers if the query filters by 'status' == 'Published' (for public search).
      // This relies on client queries being appropriately filtered.
      // For a list operation, Firestore checks the rule against each document that *could* be returned.
      allow list: if isAdmin() ||
                     (request.auth != null && request.query.filters.find(f => f[0] == 'userId' && f[2] == request.auth.uid) != null) || // User listing their own
                     (request.auth != null && request.query.filters.find(f => f[0] == 'assignedReviewerIds' && f[1] == 'array-contains' && f[2] == request.auth.uid) != null) || // Reviewer listing their assigned
                     (request.query.filters.find(f => f[0] == 'status' && f[2] == 'Published') != null); // Anyone listing published


      // CREATE:
      // - Authenticated user can create a paper.
      // - The 'userId' in the new paper document must match the creator's auth.uid.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // UPDATE:
      // - Paper owner can update their paper.
      // - Admin can update any paper.
      // - An assigned reviewer can update a paper *only* to add their review via arrayUnion.
      allow update: if isPaperOwner() || isAdmin() ||
                       (isAssignedReviewer() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews']) &&
                        request.resource.data.reviews.size() == resource.data.reviews.size() + 1 &&
                        request.resource.data.reviews[request.resource.data.reviews.size() - 1].reviewerId == request.auth.uid
                       );

      // DELETE:
      // - Paper owner can delete their paper. (Consider if this is desired)
      // - Admin can delete any paper.
      allow delete: if isPaperOwner() || isAdmin();
    }
  }
}
