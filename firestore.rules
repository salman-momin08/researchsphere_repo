
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // To allow login by username (client queries for username to get email):
      // This rule allows any client to read any user document.
      // WARNING: This makes all fields in user documents publicly readable if a client
      // can query by username or obtain/guess a userId. This is a trade-off for
      // client-side username-to-email lookup.
      // For higher security on sensitive user data, a backend Cloud Function for this lookup is recommended.
      allow read: if true;

      // Allow authenticated users to write to (update) their own document
      allow update: if request.auth != null && request.auth.uid == userId;
      // Allow authenticated users to create their user document (e.g., during signup)
      allow create: if request.auth != null && request.auth.uid == userId;
      // Disallow delete by default unless specifically needed
      allow delete: if false;
    }

    match /papers/{paperId} {
      // Public can read 'Published' papers.
      // Authenticated owners, assigned reviewers, and admins can read other papers.
      allow read: if resource.data.status == 'Published' ||
                     (request.auth != null && (
                       request.auth.uid == resource.data.userId ||
                       (request.auth.token.admin == true) || // Assumes admin custom claim
                       (resource.data.assignedReviewerIds != null && request.auth.uid in resource.data.assignedReviewerIds)
                     ));

      // Only authenticated users can create papers
      allow create: if request.auth != null;

      // Only owners or admins can update/delete papers
      allow update, delete: if request.auth != null &&
                               (request.auth.uid == resource.data.userId || (request.auth.token.admin == true));
    }

    match /contactSubmissions/{submissionId} {
      // Anyone can submit the contact form
      allow create: if true;

      // Only admins (with custom claim) can read, update, or delete contact submissions
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
