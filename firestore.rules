
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if user is the owner of a document
    function isOwner(docUserId) {
      return request.auth != null && request.auth.uid == docUserId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null; // Anyone can create their own user doc upon signup
      allow update: if isOwner(userId) || isAdmin();
      // No delete for users through client, typically done via admin panel or Firebase console
    }

    // Papers Collection
    match /papers/{paperId} {
      allow read: if resource.data.status == 'Published' || // Anyone can read published papers
                     (request.auth != null && (
                       isOwner(resource.data.userId) || // Author can read their own paper
                       isAdmin() || // Admin can read any paper
                       (request.auth.uid in resource.data.assignedReviewerIds) // Assigned reviewer can read
                     ));

      // Authenticated users can list papers; queries should filter appropriately.
      // This allows the `array-contains` query for reviewers.
      // Individual document reads are still protected by the `allow read` rule above.
      allow list: if request.auth != null;

      allow create: if request.auth != null && isOwner(request.resource.data.userId); // Only the author can create a paper under their ID

      allow update: if request.auth != null &&
                       (isOwner(resource.data.userId) || isAdmin()); // Author or Admin can update

      allow delete: if request.auth != null &&
                       (isOwner(resource.data.userId) || isAdmin()); // Author or Admin can delete
    }

    // Contact Submissions Collection
    match /contactSubmissions/{submissionId} {
      allow create: if true; // Anyone can submit a contact form
      allow read, update, delete: if isAdmin(); // Only admins can manage submissions
      allow list: if isAdmin();
    }
  }
}
